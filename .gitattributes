# Shell scripts must keep LF even when checked out on Windows (WSL / Docker / Linux)
*.sh text eol=lf

# Windows batch and PowerShell scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary
*.ttc binary
*.otf binary
*.gz binary
*.bin binary
*.mkv binary
*.exe binary
*.dll binary
